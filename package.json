    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chokidar": "^4.0.3",
    "cldr-core": "^48.2.0",
    "cldr-dates-full": "^48.2.0",
    "dom-accessibility-api": "^0.6.3",
    "esbuild": "catalog:",
    "eslint": "^10.6.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.0.8",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
