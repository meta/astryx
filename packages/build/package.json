{
  "name": "@astryxdesign/build",
  "version": "0.7.6",
  "description": "Build plugins for Astryx source builds \u2014 babel, PostCSS, and Vite integrations",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/meta/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta/astryx.git",
    "directory": "packages/build"
  },
  "bugs": {
    "url": "https://github.com/meta/astryx/issues"
  },
  "keywords": [
    "astryx",
    "postcss",
    "stylex",
    "css-layers",
    "design-system"
  ],
  "main": "./src/config.js",
  "exports": {
    ".": "./src/config.js",
    "./babel": "./src/babel.js",
    "./postcss": "./src/index.js",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs"
    },
    "./next": "./src/next.js"
  },
  "files": [
    "src",
    "dist",
    "!**/*.test.*",
    "!**/*.spec.js",
    "!**/*.spec.jsx",
    "!**/*.spec.mjs",
    "!**/*.spec.cjs",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/*.spec.mts",
    "!**/*.spec.cts",
    "!**/*.spec.d.ts",
    "!**/__tests__/**",
    "!**/__mocks__/**",
    "!**/*.bench.*"
  ],
  "scripts": {
    "api:report": "node ../../scripts/api-report/cli.mjs --package .",
    "build": "node build.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@babel/core": ">=7.0.0",
    "@stylexjs/babel-plugin": ">=0.18.0",
    "@stylexjs/unplugin": ">=0.18.0",
    "vite": "catalog:"
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.3",
    "fast-glob": "^3.3.0",
    "glob-parent": "^6.0.0",
    "is-glob": "^4.0.0",
    "lightningcss": "^1.33.0"
  },
  "devDependencies": {
    "enhanced-resolve": "^5.21.6",
    "esbuild": "catalog:"
  },
  "peerDependenciesMeta": {
    "@stylexjs/unplugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
