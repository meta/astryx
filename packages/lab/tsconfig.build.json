{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "paths": {
      "@astryxdesign/core/motion/*": ["../core/dist/motion/*"],
      "@astryxdesign/core/gestures": ["../core/dist/gestures/index"],
      "@astryxdesign/core/gestures/*": ["../core/dist/gestures/*"],
      "@astryxdesign/core/hooks/isRtlElement": [
        "../core/dist/hooks/isRtlElement"
      ],
      "@astryxdesign/core/utils/touchPresentation": [
        "../core/dist/utils/touchPresentation"
      ]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.doc.mjs",
    "src/**/__tests__/**",
    "src/**/*.perf.test.ts",
    "src/**/*.perf.test.tsx"
  ]
}
