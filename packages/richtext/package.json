{
  "name": "@astryxdesign/richtext",
  "displayName": "Rich Text",
  "version": "0.7.5",
  "description": "Astryx rich text — a Lexical-based rich text editor and viewer, styled with Astryx design tokens.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/facebook/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/astryx.git",
    "directory": "packages/richtext"
  },
  "bugs": {
    "url": "https://github.com/facebook/astryx/issues"
  },
  "keywords": [
    "astryx",
    "richtext",
    "rich-text",
    "editor",
    "lexical",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "astryx.integration.mjs",
    "blocks",
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "source": "./src/markdown.ts",
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./richtext.css": {
      "default": "./dist/richtext.css"
    }
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && pnpm build:esm && tsc --project tsconfig.build.json && node ../../scripts/add-declaration-extensions.mjs && pnpm build:css && node ../../scripts/check-no-dev-jsx.mjs && node ../../scripts/check-fully-specified.mjs",
    "build:esm": "babel src --out-dir dist --extensions \".ts,.tsx\" --out-file-extension \".js\" --ignore \"**/*.test.ts,**/*.test.tsx,**/__tests__/**,**/*.perf.test.*,**/*.doc.mjs,**/*.d.ts,**/*.css,**/*.css.d.ts\" --config-file ./babel.config.cjs",
    "build:css": "node ../../scripts/build-css.mjs --package richtext",
    "dev": "babel src --watch --out-dir dist --extensions \".ts,.tsx\" --out-file-extension \".js\" --ignore \"**/*.test.*,**/*.doc.mjs,**/*.d.ts,**/*.css*\" --config-file ./babel.config.cjs",
    "test": "vitest run --root ../..",
    "test:watch": "vitest --root ../..",
    "lint": "eslint src",
    "typecheck:docs": "tsc --project tsconfig.docs.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && pnpm typecheck:docs"
  },
  "peerDependencies": {
    "@stylexjs/stylex": ">=0.10.0",
    "@astryxdesign/core": "0.7.5",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "lexical": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/headless": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/code": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/utils": "^0.52.0"
  },
  "peerDependenciesMeta": {
    "lexical": {
      "optional": true
    },
    "@lexical/react": {
      "optional": true
    },
    "@lexical/markdown": {
      "optional": true
    },
    "@lexical/headless": {
      "optional": true
    },
    "@lexical/html": {
      "optional": true
    },
    "@lexical/link": {
      "optional": true
    },
    "@lexical/list": {
      "optional": true
    },
    "@lexical/rich-text": {
      "optional": true
    },
    "@lexical/selection": {
      "optional": true
    },
    "@lexical/code": {
      "optional": true
    },
    "@lexical/extension": {
      "optional": true
    },
    "@lexical/table": {
      "optional": true
    },
    "@lexical/utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astryxdesign/a11y-spec": "workspace:*",
    "@astryxdesign/cli": "workspace:*",
    "@babel/cli": "catalog:",
    "@babel/core": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@lexical/code": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/headless": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@stylexjs/babel-plugin": "catalog:",
    "@testing-library/react": "catalog:",
    "lexical": "^0.52.0"
  }
}
