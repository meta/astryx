{
  "name": "@astryxdesign/theme-butter",
  "version": "0.7.14",
  "displayName": "Butter Theme",
  "private": false,
  "description": "Warm, creamy yellows with a friendly blue accent. Playful enough for consumer surfaces, soft enough to stay readable.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/meta/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta/astryx.git",
    "directory": "packages/themes/butter"
  },
  "bugs": {
    "url": "https://github.com/meta/astryx/issues"
  },
  "keywords": [
    "astryx",
    "theme",
    "design-system",
    "lucide",
    "design-tokens"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/source.cjs",
  "types": "./dist/source.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/source.d.ts",
        "default": "./dist/source.mjs"
      },
      "require": {
        "types": "./dist/source.d.cts",
        "default": "./dist/source.cjs"
      }
    },
    "./built": {
      "types": "./dist/butter.d.ts",
      "import": "./dist/butter.js",
      "require": "./dist/butter.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    },
    "./fonts.css": {
      "types": "./fonts.css.d.ts",
      "default": "./fonts.css"
    }
  },
  "files": [
    "dist",
    "src",
    "palette.config.json",
    "fonts.css",
    "fonts.css.d.ts",
    "theme.css.d.ts",
    "!**/*.test.*",
    "!**/*.spec.js",
    "!**/*.spec.jsx",
    "!**/*.spec.mjs",
    "!**/*.spec.cjs",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/*.spec.mts",
    "!**/*.spec.cts",
    "!**/*.spec.d.ts",
    "!**/__tests__/**",
    "!**/__mocks__/**",
    "!**/*.bench.*"
  ],
  "scripts": {
    "api:report": "node ../../../scripts/api-report/cli.mjs --package .",
    "build": "node ../../../scripts/clean-dist.mjs && node ../../../scripts/generate-butter-palette-refs.mjs --check && astryx theme build src/butterTheme.ts -o dist/theme.css --icons-specifier ./icons.mjs && tsup && tsc --project tsconfig.build.json && node ../../../scripts/add-declaration-extensions.mjs && node ../../../scripts/emit-commonjs-declarations.mjs dist/source.d.ts && node ../../../scripts/check-fully-specified.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.66.0"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.7.14",
    "react": ">=19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.14"
  },
  "module": "./dist/source.mjs"
}
