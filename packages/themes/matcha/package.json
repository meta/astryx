{
  "name": "@astryxdesign/theme-matcha",
  "version": "0.7.6",
  "private": false,
  "description": "Earthy greens with a calm, organic feel. Naturalistic and grounded, great for wellness or content-first apps.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/meta/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta/astryx.git",
    "directory": "packages/themes/matcha"
  },
  "bugs": {
    "url": "https://github.com/meta/astryx/issues"
  },
  "keywords": [
    "astryx",
    "theme",
    "design-system",
    "lucide",
    "design-tokens"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/source.js",
  "types": "./dist/source.d.ts",
  "exports": {
    ".": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.mjs",
      "require": "./dist/source.js"
    },
    "./built": {
      "types": "./dist/matcha.d.ts",
      "import": "./dist/matcha.js",
      "require": "./dist/matcha.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    },
    "./fonts.css": {
      "types": "./fonts.css.d.ts",
      "default": "./fonts.css"
    }
  },
  "files": [
    "dist",
    "src",
    "fonts.css",
    "fonts.css.d.ts",
    "palette.config.json"
  ],
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs && node ../../../scripts/generate-matcha-palette-refs.mjs --check && astryx theme build src/matchaTheme.ts -o dist/theme.css --icons-specifier ./icons.mjs && tsup && tsc --project tsconfig.build.json && node ../../../scripts/check-fully-specified.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.18.0"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.7.6",
    "react": ">=19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.6"
  },
  "module": "./dist/source.mjs"
}
