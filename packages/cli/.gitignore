# Generated ./api and ./authoring type declarations — emitted from the JSDoc in
# api/**/*.mjs and authoring/**/*.mjs by scripts/sync-api-types.mjs. Not committed
# (like dist/ in the other packages); regenerated automatically at `prepack` so the
# published tarball always ships a fresh, in-sync type surface. Run
# `pnpm sync:api-types` to produce them locally.
#
# authoring/index.d.ts is deliberately NOT here: it is the hand-curated public
# barrel (grouped + commented), not an emitted artifact.
api/**/*.d.mts
api/*.d.mts
authoring/**/*.d.mts
authoring/*.d.mts
foundation/**/*.d.mts
foundation/*.d.mts
.api-verify/

# Transient fixture dir written by authoring-migration.tsc.test.mjs (runs the
# real tsc over migrated output); created + removed per test run.
.codemod-tsc-*/

# Stored component lists of the shipped templates, written at `prepack` by
# scripts/generate-template-components.mjs so the published package reads them
# instead of parsing each template's source. Not committed: a checkout parses.
assets/templates/components.generated.json

# Stored exports of the shipped plain-data doc files, written at `prepack` by
# scripts/generate-stored-docs.mjs so the published package reads them instead
# of importing each doc. Not committed: a checkout imports every doc.
assets/docs.generated.json

# Core's component list and imports, written at `prepack` by
# scripts/generate-component-list.mjs so the published package reads them for
# an unchanged installed Core. Not committed: a checkout works them out.
assets/component-list.generated.json

# The root help's command list, written at `prepack` by
# scripts/generate-command-list.mjs so the published package prints its root
# help without loading every command. Not committed: a checkout loads them.
clients/cli/commands.generated.json

# Written at prepack (scripts/generate-self-audit.mjs); never committed.
assets/self-audit.generated.json

# Written at prepack (scripts/generate-manifest.mjs); never committed.
clients/cli/manifest.generated.json

# Search's catalog for a project that adds nothing to it, written at `prepack`
# by scripts/generate-search-catalog.mjs so the published package reads it for
# an unchanged CLI and Core. Not committed: a checkout gathers.
assets/search-catalog.generated.json

# The id of the published package's exact contents, written last at `prepack`
# by scripts/generate-build-id.mjs. A checkout has none, so it keeps no
# gathered catalogs between runs (foundation/fs/gather-cache.mjs).
clients/cli/build-id.generated.json
