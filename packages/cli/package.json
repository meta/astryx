{
  "name": "@astryxdesign/cli",
  "version": "0.7.5",
  "displayName": "CLI",
  "description": "Scaffold projects, browse templates, generate themes, and get agent-ready docs from the command line.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/facebook/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/astryx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/facebook/astryx/issues"
  },
  "keywords": [
    "astryx",
    "cli",
    "design-system",
    "init",
    "swizzle",
    "scaffolding",
    "theme",
    "agent-docs"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "astryx": "./clients/cli/bin/astryx.mjs",
    "cli": "./clients/cli/bin/astryx.mjs"
  },
  "exports": {
    ".": "./clients/cli/bin/astryx.mjs",
    "./json": {
      "types": "./api/json/index.ts",
      "import": "./api/json/parse.mjs"
    },
    "./api": {
      "types": "./api/index.d.mts",
      "import": "./api/index.mjs"
    },
    "./api/experimental": {
      "types": "./api/experimental.d.mts",
      "import": "./api/experimental.mjs"
    },
    "./host": {
      "types": "./host/index.d.ts",
      "import": "./host/index.mjs"
    },
    "./authoring": {
      "types": "./authoring/index.d.ts",
      "import": "./authoring/index.mjs"
    },
    "./config": {
      "types": "./authoring/config/type.ts",
      "import": "./authoring/config/parse.mjs"
    },
    "./debug": {
      "types": "./authoring/debug/type.ts",
      "import": "./authoring/debug/parse.mjs"
    },
    "./integration": {
      "types": "./authoring/integration/type.ts",
      "import": "./authoring/integration/parse.mjs"
    },
    "./doc": {
      "types": "./authoring/doctypes/types.ts",
      "import": "./authoring/doctypes/parse.mjs"
    },
    "./template": {
      "types": "./authoring/doctypes/types.ts",
      "import": "./authoring/doctypes/template/parse.mjs"
    },
    "./codemod": {
      "types": "./authoring/codemod/type.ts",
      "import": "./authoring/codemod/parse.mjs"
    },
    "./xle": {
      "types": "./foundation/xle/browser.d.ts",
      "import": "./foundation/xle/browser.mjs"
    }
  },
  "files": [
    "clients",
    "api",
    "assets",
    "authoring",
    "foundation",
    "host",
    "scripts/postinstall.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "astryx": "node clients/cli/bin/astryx.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "cd ../.. && vitest run packages/cli",
    "test:watch": "cd ../.. && vitest packages/cli",
    "typecheck": "pnpm typecheck:template-docs && pnpm typecheck:strict",
    "typecheck:template-docs": "tsc --project tsconfig.template-docs.json",
    "typecheck:json-api": "tsc --project tsconfig.json-api.json",
    "typecheck:strict": "tsc --project tsconfig.strict.json",
    "typecheck:authoring": "tsc --project tsconfig.authoring-contract.json",
    "sync:api-types": "node scripts/sync-api-types.mjs",
    "readme": "node scripts/generate-cli-readme.mjs",
    "readme:check": "node scripts/generate-cli-readme.mjs --check",
    "prepack": "pnpm sync:api-types"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.8",
    "@babel/plugin-transform-typescript": "7.29.7",
    "@babel/types": "7.29.8",
    "@stylexjs/babel-plugin": "catalog:",
    "ast-types": "0.16.3",
    "commander": "^12.1.0",
    "ignore": "^7.0.5",
    "jiti": "^2.7.0",
    "jscodeshift": "^17.3.0",
    "node-diff3": "3.2.1",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.6",
    "recast": "0.23.21",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@astryxdesign/charts": "*",
    "@astryxdesign/core": "*",
    "@astryxdesign/lab": "*",
    "@astryxdesign/theme-neutral": "*"
  },
  "peerDependenciesMeta": {
    "@astryxdesign/charts": {
      "optional": true
    },
    "@astryxdesign/core": {
      "optional": true
    },
    "@astryxdesign/lab": {
      "optional": true
    },
    "@astryxdesign/theme-neutral": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astryxdesign/charts": "*",
    "@astryxdesign/core": "*",
    "@astryxdesign/lab": "*",
    "@astryxdesign/theme-neutral": "*",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "catalog:",
    "@types/babel__core": "^7.20.5",
    "lucide-react": "^1.18.0",
    "recharts": "^3.9.2"
  }
}
