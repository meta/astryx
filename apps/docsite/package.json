{
  "name": "@astryxdesign/docsite",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:theme": "astryx theme build src/themes/astryxTheme.ts --out src/themes/astryx.css",
    "generate": "node scripts/check-workspace-build.mjs && pnpm build:theme && node scripts/generate-data.mjs && node scripts/generate-scope.mjs && node scripts/generate-playground-types.mjs && node scripts/copy-vendor.mjs",
    "dev": "pnpm generate && node ../../scripts/generate-i18n-runtime.mjs --watch -- pnpm --parallel --filter @astryxdesign/core --filter @astryxdesign/docsite dev:i18n",
    "dev:i18n": "next dev --webpack",
    "build": "pnpm generate && next build --webpack && node scripts/check-template-gallery-bundle.mjs && node scripts/check-function-size.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@monaco-editor/react": "^4.8.0-rc.3",
    "@stylexjs/stylex": "catalog:",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@astryxdesign/charts": "*",
    "@astryxdesign/cli": "*",
    "@astryxdesign/core": "*",
    "@astryxdesign/lab": "*",
    "@astryxdesign/richtext": "*",
    "@astryxdesign/theme-butter": "*",
    "@astryxdesign/theme-gothic": "*",
    "@astryxdesign/theme-matcha": "*",
    "@astryxdesign/theme-neutral": "*",
    "@astryxdesign/theme-stone": "*",
    "@astryxdesign/theme-y2k": "*",
    "@astryxdesign/vega": "*",
    "fflate": "^0.8.2",
    "lucide-react": "^1.59.0",
    "lz-string": "^1.5.0",
    "mcp-handler": "^1.1.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.2",
    "prettier": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/parser": "^7.29.7",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@stylexjs/babel-plugin": "catalog:",
    "@stylexjs/postcss-plugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lz-string": "^1.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "shadcn": "4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "last 1 Chrome version"
  ]
}
