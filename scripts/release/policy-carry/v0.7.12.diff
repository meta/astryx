+    const files = diffEntryFiles(entry);
+    if (files === null) {
+      errors.push(`invalid diff entry: ${entry}`);
+      continue;
+    }
+    for (const file of files) {
+      if (!isReleaseTestRepairPath(file))
+        errors.push(`release test repair contains a non-test path: ${file}`);
+    }
